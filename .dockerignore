# Only Dockerfile inputs enter the build context. Keep this in sync with its
# COPY statements; future source extensions or public assets need review.
*
**/*
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!next-env.d.ts
!src/*.ts
!src/*.tsx
!src/*.css
!src/**/*.ts
!src/**/*.tsx
!src/**/*.css
!public/icon.svg
!public/icon-192.png
!public/icon-512.png
!public/apple-touch-icon.png
!scripts/check-codecs.mjs
!scripts/smoke-container.mjs
