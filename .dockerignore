# Only Dockerfile inputs enter the build context. Keep this in sync with its
# COPY statements; future source extensions or public assets need review.
*
**/*
# Docker 20.10, used by Cloud Build, does not enter an excluded directory to
# apply a later file exception. Name each source directory. A wildcard such as
# !src/**/ also re-includes files on that client, so do not use one here.
!src/
!src/app/
!src/app/api/
!src/app/api/analyze/
!src/app/api/meals/
!src/app/api/meals/photo/
!src/app/api/nutrition/
!src/app/api/nutrition/resolve/
!src/app/api/status/
!src/app/sw.js/
!src/components/
!src/content/
!src/lib/
!src/lib/client/
!src/lib/domain/
!src/lib/evaluation/
!src/lib/firebase/
!src/lib/meals/
!src/lib/nutrition/
!src/lib/providers/
!src/lib/providers/food-vision/
!src/lib/pwa/
!src/lib/server/
!src/test/
# Docker 20.10 treats a re-included directory as including every nested file.
# Exclude those files again, then restore only the source extensions below.
src/**
!src/app/api/meals/[[]id]/
!src/app/api/meals/[[]id]/photo/
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!next-env.d.ts
!src/*.ts
!src/*.tsx
!src/*.css
!src/**/*.ts
!src/**/*.tsx
!src/**/*.css
!public/icon.svg
!public/icon-192.png
!public/icon-512.png
!public/apple-touch-icon.png
!scripts/check-codecs.mjs
!scripts/smoke-container.mjs
