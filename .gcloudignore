.gcloudignore
# Cloud Build receives only Dockerfile inputs and its own config. A misplaced
# private local file is not uploaded merely because it sits under src/public.
*
**/*
!Dockerfile
!.dockerignore
!.gcloudignore
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!next-env.d.ts
!deploy/
!deploy/cloudbuild.yaml
!src/
!src/**/
!src/*.ts
!src/*.tsx
!src/*.css
!src/**/*.ts
!src/**/*.tsx
!src/**/*.css
!public/
!public/icon.svg
!public/icon-192.png
!public/icon-512.png
!public/apple-touch-icon.png
!scripts/
!scripts/check-codecs.mjs
!scripts/smoke-container.mjs
