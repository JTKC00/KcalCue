# OpenAI Live Mode (leave OPENAI_API_KEY empty to use the clearly labelled Demo Mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional USDA FoodData Central key for unresolved Live foods.
# The app starts, Demo Mode, local matching and partial results work without it.
NUTRITION_API_KEY=

# Firebase Web App public config. No Firebase Storage bucket is required.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Prefer Application Default Credentials on Google Cloud.
# For other hosts supply a dedicated service account's credentials as secret env vars.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Required, comma-separated verified trial emails. Empty denies API access.
KCALCUE_ALLOWED_EMAILS=
