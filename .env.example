# OpenAI Live Mode (leave OPENAI_API_KEY empty to use the clearly labelled Demo Mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional USDA FoodData Central key for unresolved Live foods.
# The app starts, Demo Mode, local matching and partial results work without it.
NUTRITION_API_KEY=

# Independent Supabase project. Publishable key is intentionally public; RLS protects private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
