# OpenAI remains the default Live provider. Leave OPENAI_API_KEY empty to use Demo Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# RC-only. Unset or openai keeps the OpenAI path above. gemini requires GEMINI_API_KEY
# and uses gemini-3.8-flash at medium thinking. Do not set this in production.
# KCALCUE_VISION_PROVIDER=openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Set false to stop new paid analyses without disabling the meal journal.
KCALCUE_ANALYSIS_ENABLED=true
# QA only. Leave unset. Exactly 1 on a zero-traffic stage serves a suspected-milk
# fixture when the photo request also sends qaSuspectedMilk=1. promote, rollback,
# and access-promote refuse any revision that has this variable.
# KCALCUE_QA_SUSPECTED_MILK=1
# QA only. Leave unset. Exactly 1 on a zero-traffic stage runs non-authoritative
# milk-serving Shadow comparison on live /api/analyze requests for verified QA
# principals listed in KCALCUE_QA_SHADOW_ALLOWED_EMAILS (fail-closed subset of
# KCALCUE_ALLOWED_EMAILS). promote, rollback, and access-promote refuse any
# revision that has either variable.
# KCALCUE_QA_SERVING_SHADOW=1
# KCALCUE_QA_SHADOW_ALLOWED_EMAILS=

# Optional USDA FoodData Central key for unresolved Live foods.
# The app starts, Demo Mode, local matching and partial results work without it.
NUTRITION_API_KEY=

# Firebase Web App public config. Normal meal tracking requires no Storage bucket.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Prefer Application Default Credentials on Google Cloud.
# For other hosts supply a dedicated service account's credentials as secret env vars.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Required, comma-separated verified trial emails. Empty denies API access.
KCALCUE_ALLOWED_EMAILS=
# Server-only, optional private History-photo bucket. Leave empty until the
# upload, generation-aware cleanup, IAM and retention release gates are met.
KCALCUE_MEAL_PHOTO_BUCKET=
